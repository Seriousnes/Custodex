<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsPackable>true</IsPackable>
		<MinVerTagPrefix>client-v</MinVerTagPrefix>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<Description>gRPC client for the Custodex authorization service: the same IAuthorizer and management interfaces as the embedded engine, over the wire.</Description>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Grpc.Net.Client" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Custodex.Abstractions\Custodex.Abstractions.csproj" />
		<ProjectReference Include="..\Custodex.Protos\Custodex.Protos.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Custodex.Client.Tests" />
	</ItemGroup>

</Project>
