<Project Sdk="Microsoft.NET.Sdk">

	<ItemGroup>
	  <ProjectReference Include="..\Custodex.Abstractions\Custodex.Abstractions.csproj" />
	</ItemGroup>

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>Custodex</RootNamespace>
		<IsPackable>true</IsPackable>
		<PackageId>Custodex</PackageId>
		<Description>The runtime-configurable ReBAC + ABAC authorization engine — the portable, dependency-light evaluation core.</Description>
	</PropertyGroup>

	<ItemGroup>
	  <InternalsVisibleTo Include="Custodex.Core.Tests" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
	  <PackageReference Include="OpenTelemetry" Version="1.16.0" />
	</ItemGroup>

</Project>
