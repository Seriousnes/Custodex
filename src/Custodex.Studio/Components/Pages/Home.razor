@page "/studio"
@inject StudioConnectionState State

<PageTitle>Custodex Studio</PageTitle>

<h1>Operator console</h1>

<section class="studio-panel" aria-label="Connection">
    <h2>Connection</h2>
    <label class="studio-field">
        <span>Store</span>
        <input class="studio-input" @bind="_store" />
    </label>
    <label class="studio-field">
        <span>Tenant</span>
        <input class="studio-input" @bind="_tenant" />
    </label>
    <button class="studio-button" @onclick="Connect" disabled="@CannotConnect">Connect</button>
</section>

<section class="studio-widgets" aria-label="Widgets">
</section>

@code {
    private string _store = string.Empty;
    private string _tenant = string.Empty;

    private bool CannotConnect => string.IsNullOrWhiteSpace(_store) || string.IsNullOrWhiteSpace(_tenant);

    private void Connect() => State.Connect(_store, _tenant);
}
