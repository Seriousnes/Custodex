<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>true</IsPackable>
		<Description>PostgreSQL storage provider for Custodex, built on Npgsql and Dapper.</Description>
	</PropertyGroup>

	<ItemGroup>
		<EmbeddedResource Include="Migrations/*.sql" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
		<PackageReference Include="Npgsql" />
		<PackageReference Include="Dapper" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Custodex.Abstractions\Custodex.Abstractions.csproj" />
		<ProjectReference Include="..\Custodex.Core\Custodex.Core.csproj" />
	</ItemGroup>

</Project>
